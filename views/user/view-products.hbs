<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ecommerce</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f3f6;
            font-family: 'Roboto', sans-serif;
        }
        .navbar {
            background-color: #2874f0;
            padding: 0.5rem 1rem;
        }
        .navbar-brand {
            color: #fff;
            font-weight: bold;
            font-size: 1.5rem;
        }
        .search-bar {
            width: 100%;
            max-width: 500px;
        }
        .container {
            margin-top: 20px;
        }
        .product-card {
            background-color: #fff;
            border: none;
            border-radius: 2px;
            box-shadow: 0 2px 4px 0 rgba(0,0,0,.08);
            transition: box-shadow 0.3s ease;
            height: 100%;
        }
        .product-card:hover {
            box-shadow: 0 4px 8px 0 rgba(0,0,0,.16);
        }
        .card-img-top {
            height: 200px;
            object-fit: contain;
            padding: 1rem;
        }
        .card-body {
            padding: 1rem;
        }
        .card-title {
            font-size: 1rem;
            font-weight: 500;
            color: #212121;
            margin-bottom: 0.5rem;
        }
        .card-text {
            color: #878787;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }
        .price {
            font-size: 1.125rem;
            font-weight: 500;
            color: #212121;
        }
        .btn-primary {
            background-color: #ff9f00;
            border-color: #ff9f00;
            color: #fff;
            font-weight: 500;
        }
        .btn-primary:hover {
            background-color: #fb641b;
            border-color: #fb641b;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Ecommerce</a>
            <form class="d-flex search-bar">
                <input class="form-control me-2" type="search" placeholder="Search for products, brands and more" aria-label="Search">
                <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
            </form>
        </div>
    </nav>

    <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            {{#each data}}
            <div class="col">
                <div class="card product-card">
                    <img class="card-img-top" src="/product-images/{{this._id}}.jpg" alt="{{this.Name}}">
                    <div class="card-body">
                        <h5 class="card-title">{{this.Name}}</h5>
                        <p class="card-text">{{this.Description}}</p>
                        <p class="card-text"><small>{{this.Category}}</small></p>
                        <p class="price">₹{{this.Price}}</p>
                        <button onclick="addtocart('{{this._id}}')" class="btn btn-primary w-100">Add to cart</button>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>