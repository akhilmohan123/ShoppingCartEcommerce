</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // DOM Elements
    const scanButton = document.getElementById('scan-button');
    const scanningUi = document.getElementById('scanning-ui');
    const resultsUi = document.getElementById('results-ui');
    const photoCaptureui = document.getElementById('photo-capture-ui');
    const photoInput = document.getElementById('photo-input');
    const photoPreview = document.getElementById('photo-preview');
    const proceedButton = document.getElementById('proceed-button');
    const captureButton = document.getElementById('capture-button');
    const video = document.getElementById('video');
    const spinner = document.getElementById('spinner');
    let mediaStream = null;
    let file = null;

    // Start webcam feed
    async function startWebcam() {
      try {
        mediaStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        video.srcObject = mediaStream;
      } catch (error) {
        console.error('Error accessing the webcam:', error);
        alert('Unable to access the webcam. Please ensure your camera is enabled.');
      }
    }

    // Stop webcam feed
    function stopWebcam() {
      if (mediaStream) {
        mediaStream.getTracks().forEach(track => track.stop());
      }
    }

    // Show spinner
    function showSpinner() {
      spinner.style.display = 'flex';
    }

    // Hide spinner
    function hideSpinner() {
      spinner.style.display = 'none';
    }

    // Switch to photo capture UI
    scanButton.addEventListener('click', () => {
      scanningUi.style.display = 'none';
      photoCaptureui.style.display = 'block';
      startWebcam();
    });

    // Handle file input
    photoInput.addEventListener('change', (event) => {
      file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (e) => {
          photoPreview.innerHTML = `<img src="${e.target.result}" alt="Captured Photo" class="captured-photo">`;
          proceedButton.disabled = false;
        };
        reader.readAsDataURL(file);
      }
    });

    // Capture photo from webcam
    captureButton.addEventListener('click', () => {
      const canvas = document.createElement('canvas');
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      const context = canvas.getContext('2d');
      context.drawImage(video, 0, 0, canvas.width, canvas.height);
      const dataURL = canvas.toDataURL('image/jpeg');
      file = dataURL;
      photoPreview.innerHTML = `<img src="${dataURL}" alt="Captured Photo" class="captured-photo">`;
      proceedButton.disabled = false;
    });

    // Handle proceed button click
    proceedButton.addEventListener('click', async () => {
      showSpinner(); // Show spinner while fetching data
      const formData = new FormData();
      let blob;
      if (typeof file == 'string') {
        // Convert dataURL to Blob
        blob = await fetch(file).then((res) => res.blob());
      } else {
        // Use the file directly if it's from the file input
        blob = file;
      }

      formData.append('file', blob, 'captured-image.jpg');
      
      try {
        $.ajax({
          url: "/facedetect",
          type: "POST",
          data: formData,
          processData: false,
          contentType: false,
          success: function(response) {
            console.log("Success:", response);
            hideSpinner(); // Hide spinner when done

            const data = response.data; // The array of product objects
            const recommendationsContainer = document.querySelector('.results-section .recommendations');
            
            // Clear previous recommendations
            recommendationsContainer.innerHTML = '';

            // Loop through the data array to create a new item for each product
            data.forEach(item => {
              const itemElement = document.createElement('div');
              itemElement.classList.add('item');
              
              // Populate the item element with the product details
              itemElement.innerHTML = `
                <img src="/product-images/${item._id}.jpg"alt="${item.Name}">
                <p>${item.Name}</p>
                <p><strong>Category:</strong> ${item.Category}</p>
                <p><strong>Price:</strong> $${item.Price}</p>
                <p>${item.Description}</p>
                <button id="addtocart" data-id="${item._id}" onclick="handlecart('${item._id}',this)" class="buy-button">Add to Cart</button>
              `;
              
              // Append the item element to the recommendations container
              recommendationsContainer.appendChild(itemElement);
            });

            // Show the results UI and hide the capture UI
            photoCaptureui.style.display = 'none';
            resultsUi.style.display = 'block';
            stopWebcam(); // Stop the webcam feed
          },

          error: function(xhr, status, error) {
            console.log(error);
            hideSpinner(); // Hide spinner on error
          }
        });
      } catch (error) {
        console.error(error);
        hideSpinner(); // Hide spinner on error
      }
    });
  });
  function handlecart(id){
    let button=document.querySelector(`button[data-id='${id}']`)
    if (button){
      button.innerText='Added'
    }
    
     $.ajax({
          url: `/cart/${id}`,
          type: "GET",
          processData: false,
          contentType: false,
          success: function(response) {
            console.log("Success:", response);
           
           
          },

          error: function(xhr, status, error) {
            console.log(error);
         
          }
        });
     
  
  }
  function handlegoback(){
   window.location.href = "/";
  }
</script>

