<section>
  <div class="main">
  <div class="background-image"></div>
  
  <div class="container">
    <!-- Scanning UI -->
    <div id="scanning-ui" class="scanning-ui">
      <div class="header">
        <h1>AI Face Scan</h1>
        <p>Position your face within the frame for scanning.</p>
      </div>
      <div class="scanner-container">
        <div class="scanner-frame">
          <img src="images/facescan.jpg" alt="Face Scan Preview" class="face-preview">
          <video id="video" autoplay playsinline></video><!--Webcam feed will be displayed here-->
          <div class="scan-overlay"></div>
        </div>
        <button id="scan-button" class="scan-button">Start Scan</button>
      </div>
    </div>

    <!-- Photo Capture UI -->
    <div id="photo-capture-ui" class="photo-capture-ui" style="display: none;">
      <div class="header">
        <h1>Capture Your Photo</h1>
        <p>Please upload or capture a clear photo of your face.</p>
      </div>
      <div class="photo-container">
        <!-- upload photo option --->
        <input type="file" id="photo-input" accept="image/*" style="display: none;">
        <label for="photo-input" class="photo-upload-button">Upload Photo</label>

        <!-- Live Capture Option -->
        <button id="capture-button" class="photo-upload-button">Capture Live Photo</button>

        <!-- photo preview --->
        <div id="photo-preview" class="photo-preview"></div>
        <button id="proceed-button" class="proceed-button" disabled>Proceed to Result</button>
      </div>
    </div>

    <!-- Results UI -->
    <div id="results-ui" class="results-ui" style="display: none;">
      <div class="header">
        <h1>AI Face Scan Results</h1>
        <p>Here are your personalized recommendations based on your scan.</p>
      </div>

      <!-- Dress Recommendations -->
      <div class="results-section">
        <h2>Recommendations</h2>
        <div class="recommendations">
          <!-- Items will be inserted here dynamically -->
        </div>
      </div>
      <button class="gobackbtn" onclick="handlegoback()">Click Here to go back</button>
    </div>

    <!-- Spinner -->
    <div id="spinner" class="spinner" style="display: none;">
      <div class="loader"></div>
    </div>
  </div>
  </div>

</section>
