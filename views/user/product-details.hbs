<!-- views/user/product-details.hbs or .ejs -->
<section class="container mt-5">
       <div class="body">
        <div class="success-notification">
  <span class="close-button">&times;</span>
  <p>Success! Your action was completed successfully.</p>
</div>
    <div class="card shadow-lg p-4 rounded-lg">
        <h1 class="text-center mb-4 text-primary">Product Details</h1>
        <div class="row align-items-center">
            <!-- Product Image -->
            <div class="col-md-5 text-center">
                <img src="/product-images/{{product._id}}.jpg" alt="{{product.name}}" class="img-fluid rounded shadow">
            </div>
            <!-- Product Info -->
            <div class="col-md-7">
                <h2 class="text-dark font-weight-bold">{{product.Name}}</h2>
                <p class="text-muted">{{product.Description}}</p>
                <p class="text-success font-weight-bold">Price: ₹{{product.Price}}</p>
                <div class="mt-4">
                    <a href="/order" class="btn btn-outline-primary btn-lg">Back to Orders</a>
                    <button class="btn btn-success btn-lg ml-3" onclick="handleclick('{{product._id}}')" >Order Again</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Custom Styles -->
<style>
    .card {
        background: #f8f9fa; /* Light grey background */
        border-radius: 12px;
        border: none;
    }
    .img-fluid {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
    }
    h1, h2 {
        font-family: 'Poppins', sans-serif;
    }
    .success-notification {
  padding: 15px;
  background-color: #4CAF50; /* Green */
  color: white;
  border-radius: 5px;
  position: fixed; /* Or absolute, depending on your layout */
  top: 20px; /* Adjust as needed */
  left: 50%;
  transform: translateX(-50%);
  z-index: 1000; /* Ensure it appears on top */
  display: none; /* Initially hidden */
}

.success-notification .close-button {
  float: right;
  font-weight: bold;
  cursor: pointer;
}

.success-notification .close-button:hover {
  color: black;
}

/* Optional: Add animation for showing/hiding */
.success-notification.show {
  display: block; /* Or visibility: visible, depending on your animation */
}
</style>
<script>
document.addEventListener("DOMContentLoaded", function () {
    const notification = document.querySelector('.success-notification');
    const closeButton = document.querySelector('.close-button');

    function showNotification() {
        console.log("showNotification called"); // Debugging log
        if (!notification) {
            console.error("Notification element not found!");
            return;
        }
        notification.classList.add('show');
        setTimeout(hideNotification, 3000); // Auto-hide after 3 seconds
    }

    function hideNotification() {
        if (notification) {
            notification.classList.remove('show');
        }
    }

    if (closeButton) {
        closeButton.addEventListener('click', hideNotification);
    } else {
        console.error("Close button not found!");
    }

    function handleclick(id) {
        console.log("handleclick called with ID:", id); // Debugging log
        fetch(`/cart/${id}`, {
            method: 'GET',
        })
        .then(response => {
            if (response.ok) {
                console.log("Product added successfully");
                showNotification();
                alert("Product added successfully");
            } else {
                throw new Error("Something went wrong...");
            }
        })
        .catch(error => {
            console.error("AJAX Error:", error);
            alert("Something went wrong, please try again later...");
        });
    }

    // Make the function globally accessible
    window.handleclick = handleclick;
});
</script>
