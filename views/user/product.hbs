<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Details</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">Ecommerce</a>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="product-container">
            <!-- Image Section -->
            <div class="image-div">
                <img src="/product-images/{{products._id}}.jpg" id="image" alt="Product Image">
            </div>

            <!-- Details Section -->
            <div class="details">
                <h2>{{products.Name}}</h2>
                <p class="price">{{products.Category}}</p>
                <p class="price">{{products.Price}}</p>
                <p><b>Description:</b> {{products.Description}}.</p>
                <button onclick="addtocart('{{products._id}}')" class="btn btn-primary" >Add to Cart</button>
            </div>
        </div>
    </div>
</body>
</html>
<script>
 

</script>

<style>
    /* Navbar Styling */
    .navbar {
        background-color: #1a283e;
        padding: 0.5rem 1rem;
    }
    .navbar-brand {
        color: #fff;
        font-weight: bold;
        font-size: 1.5rem;
    }

    /* Product Container */
    .product-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 40px;
        padding: 20px;
    }

    /* Image Styling */
    .image-div img {
        height: 300px;
        width: 300px;
        border-radius: 10px;
        box-shadow: 2px 2px 15px rgba(0, 0, 0, 0.2);
    }

    /* Details Styling */
    .details {
        max-width: 400px;
    }
    .details h2 {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
    }
    .price {
        font-size: 22px;
        font-weight: bold;
        color: #007bff;
    }
    .details p {
        font-size: 16px;
        color: #333;
        margin-bottom: 15px;
    }
    .btn {
        font-size: 16px;
        padding: 10px 20px;
    }

</style>
