 <div class="container">
        <div class="login-container">
            <h2 class="text-center mb-4">Login</h2>
            <form action="/login" method="post">
                {{#if Loginerr}}
                <p class="error">{{Loginerr}}</p>
                {{/if}}
                <div class="mb-3">
                    <label for="email" class="form-label"><i class="fas fa-envelope form-icon"></i>Email address</label>
                    <input type="email" class="form-control" id="email" name="Email" placeholder="Enter your email" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label"><i class="fas fa-lock form-icon"></i>Password</label>
                    <input type="password" class="form-control" id="password" name="Password" placeholder="Enter your password" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>
            <div class="create-account">
                <a href="/signup" class="text-decoration-none">Create new Account</a>
            </div>
        </div>
    </div>
