<section class="orders-section">
  <div class="orders-container">
    {{#if orders.length}}
    <div class="orders-header">
      <h2>Your Orders</h2>
      <div class="search-container">
        <input type="text" class="search-bar" placeholder="Search your orders...">
        <i class="fas fa-search"></i>
      </div>
    </div>
    
    <div class="orders-table-container">
      <table class="orders-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Address</th>
            <th>Pincode</th>
            <th>Payment</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Products</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
          <tr class="order-row">
            <!-- Order details (rowspan for multi-product orders) -->
            <td rowspan="{{products.length}}" class="order-date">{{Date}}</td>
            <td rowspan="{{products.length}}" class="order-address">{{delivarydetails.address}}</td>
            <td rowspan="{{products.length}}" class="order-pincode">{{delivarydetails.pincode}}</td>
            <td rowspan="{{products.length}}" class="order-payment">{{paymentmethod}}</td>
            <td rowspan="{{products.length}}" class="order-price">₹{{totalprice}}</td>
            <td rowspan="{{products.length}}" class="order-status">
              <span class="status-badge status-{{status}}">{{status}}</span>
            </td>

            <!-- First product row -->
            <td class="order-product">{{products.[0].name}}</td>
            <td rowspan="{{products.length}}" class="order-actions">
              <a href="/viewproduct/{{products.[0].item}}" class="view-product-btn">
                <i class="fas fa-eye"></i> View
              </a>
            </td>
          </tr>

          <!-- Additional product rows for the same order -->
          {{#each products}}
            {{#unless @first}}
            <tr class="product-row">
              <td class="order-product">{{this.name}}</td>
            </tr>
            {{/unless}}
          {{/each}}
          {{/each}}
        </tbody>
      </table>
    </div>
    {{else}}
    <div class="no-orders">
      <div class="no-orders-icon">
        <i class="fas fa-box-open"></i>
      </div>
      <h3>No Orders Yet</h3>
      <p>You haven't placed any orders with us yet.</p>
      <a href="/" class="shop-now-btn">Start Shopping</a>
    </div>
    {{/if}}
  </div>
</section>

<style>
  :root {
    --primary: #2563eb;
    --primary-light: #3b82f6;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --light: #f8fafc;
    --light-gray: #e2e8f0;
    --gray: #94a3b8;
    --dark-gray: #64748b;
    --dark: #1e293b;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
    --shadow-md: 0 4px 6px rgba(0,0,0,0.1);
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 12px;
    --transition: all 0.3s ease;
  }

  .orders-section {
    padding: 2rem 0;
    min-height: 70vh;
    background-color: var(--light);
  }

  .orders-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .orders-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .orders-header h2 {
    font-size: 1.8rem;
    color: var(--dark);
    font-weight: 600;
  }

  .search-container {
    position: relative;
    width: 300px;
  }

  .search-bar {
    width: 100%;
    padding: 0.5rem 1rem 0.5rem 2.5rem;
    border: 1px solid var(--light-gray);
    border-radius: var(--radius-md);
    font-size: 0.9rem;
    transition: var(--transition);
  }

  .search-bar:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
  }

  .search-container i {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
  }

  .orders-table-container {
    overflow-x: auto;
    background: white;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .orders-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  .orders-table th {
    background-color: var(--light-gray);
    color: var(--dark);
    font-weight: 600;
    text-align: left;
    padding: 1rem;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .orders-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--light-gray);
    color: var(--dark-gray);
    vertical-align: middle;
  }

  .order-row:hover, .product-row:hover {
    background-color: rgba(59, 130, 246, 0.05);
  }

  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .status-delivered {
    background-color: rgba(16, 185, 129, 0.1);
    color: var(--success);
  }

  .status-pending {
    background-color: rgba(245, 158, 11, 0.1);
    color: var(--warning);
  }

  .status-cancelled {
    background-color: rgba(239, 68, 68, 0.1);
    color: var(--danger);
  }

  .order-product {
    font-weight: 500;
    color: var(--dark);
  }

  .view-product-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--primary);
    font-weight: 500;
    text-decoration: none;
    transition: var(--transition);
    padding: 0.5rem;
    border-radius: var(--radius-sm);
  }

  .view-product-btn:hover {
    background-color: rgba(37, 99, 235, 0.1);
  }

  .view-product-btn i {
    font-size: 0.9rem;
  }

  .no-orders {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    max-width: 500px;
    margin: 0 auto;
  }

  .no-orders-icon {
    font-size: 3rem;
    color: var(--gray);
    margin-bottom: 1.5rem;
  }

  .no-orders h3 {
    font-size: 1.5rem;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .no-orders p {
    color: var(--dark-gray);
    margin-bottom: 1.5rem;
  }

  .shop-now-btn {
    display: inline-block;
    background-color: var(--primary);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    transition: var(--transition);
  }

  .shop-now-btn:hover {
    background-color: var(--primary-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 768px) {
    .orders-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .search-container {
      width: 100%;
    }
  }
</style>

<script>
  // Format date function (you would need to implement this)
  function formatDate(dateString) {
    const options = { year: 'numeric', month: 'short', day: 'numeric' };
    return new Date(dateString).toLocaleDateString(undefined, options);
  }
</script>