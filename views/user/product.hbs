
<section>
    <div class="container mt-5">
        <div class="product-container">
            <!-- Image Section -->
            <div class="image-div">
                <img src="/product-images/{{products._id}}.jpg" id="image" alt="Product Image">
            </div>

            <!-- Details Section -->
            <div class="details">
                <h2>{{products.Name}}</h2>
                <p class="price">{{products.Category}}</p>
                <p class="price">{{products.Price}}</p>
                <p><b>Description:</b> {{products.Description}}.</p>
                <button onclick="addtocart('{{products._id}}')" class="btn btn-primary" >Add to Cart</button>
            </div>
        </div>
    </div>
</section>

<style>
  
    /* Product Container */
    .product-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 40px;
        padding: 20px;
    }

    /* Image Styling */
    .image-div img {
        height: 300px;
        width: 300px;
        border-radius: 10px;
        box-shadow: 2px 2px 15px rgba(0, 0, 0, 0.2);
    }

    /* Details Styling */
    .details {
        max-width: 400px;
    }
    .details h2 {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
    }
    .price {
        font-size: 22px;
        font-weight: bold;
        color: #007bff;
    }
    .details p {
        font-size: 16px;
        color: #333;
        margin-bottom: 15px;
    }
    .btn {
        font-size: 16px;
        padding: 10px 20px;
    }

</style>
