<section class="container my-5">
  <div class="card shadow-lg p-4">
    <h2 class="mb-4 text-center">Shopping Cart</h2>

    <table class="table table-hover align-middle" id="cart-table">
      <thead class="thead-dark">
        <tr>
          <th scope="col">Item</th>
          <th scope="col">Description</th>
          <th scope="col">Quantity</th>
          <th scope="col">Price</th>
          <th scope="col">Remove</th>
        </tr>
      </thead>
      <tbody>
        {{#if products.length}}
          {{#each products}}
            <tr>
              <td class="text-center">
                <img src="/product-images/{{this.product._id}}.jpg" class="img-thumbnail" style="height:80px; width:80px;">
              </td>
              <td>
                <h5>{{this.product.Description}}</h5>
              </td>
              <td>
                <button class="btn btn-outline-danger btn-sm mr-2" 
                        onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', -1)">
                  <i class="fas fa-minus ">-</i>
                </button>
                <span id="{{this.product._id}}" class="mx-2 font-weight-bold mt-4">{{this.quantity}}</span>
                <button class="btn btn-outline-success btn-sm mt-2" 
                        onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', 1)">
                  <i class="fas fa-plus">+</i>
                </button>
              </td>
              <td class="font-weight-bold">₹{{this.product.Price}}</td>
              <td>
                <button class="btn btn-danger btn-sm" 
                        onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', -{{this.quantity}})">
                  <i class="fas fa-trash-alt">Remove</i>
                </button>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="5" class="text-center">
              <h3>Your cart is empty</h3>
              <p>It looks like you haven't added any products to your cart yet.</p>
              <a href="/shop" class="btn btn-primary mt-3">Go to Shop</a>
            </td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <hr>
    {{#if products.length}}
      <div class="d-flex justify-content-between align-items-center mt-4">
        <h3>Total Price: ₹<span id="total">{{total}}</span></h3>
        <a href="/place-order" class="btn btn-success btn-lg">Place Order</a>
      </div>
    {{/if}}
  </div>
</section>

<script>
  function Change(cartid, proid, userid, count) {
    let quantity = parseInt(document.getElementById(proid).innerHTML);
    count = parseInt(count);

    $.ajax({
      url: '/change-product-quantity/',
      data: {
        user: userid,
        cart: cartid,
        product: proid,
        count: count,
        quantity: quantity
      },
      method: 'post',
      success: (response) => {
        if (response.removeproduct) {
          alert("Product removed");
          location.reload(); // Reload to update cart
        } else {
          document.getElementById(proid).innerHTML = quantity + count;
          document.getElementById('total').innerHTML = response.total;
        }
      }
    });
  }
</script>
