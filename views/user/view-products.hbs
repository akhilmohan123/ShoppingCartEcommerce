
    <style>
        .body {
            background-color: #f1f3f6;
            font-family: 'Roboto', sans-serif;
            height: 100%;
            width: 100%;
        }
         nav{
          height: 50px;
        }
        .navbar {
            background-color: #1a283e;
            padding: 0.5rem 1rem;
        }
        .navbar-brand {
            color: #fff;
            font-weight: bold;
            font-size: 1.5rem;
        }
        .search-bar {
            width: 100%;
            max-width: 500px;
        }
        .container {
            margin-top: 20px;
        }
        .product-card {
            background-color: #fff;
            border: none;
            border-radius: 2px;
            box-shadow: 0 2px 4px 0 rgba(0,0,0,.08);
            transition: box-shadow 0.3s ease;
            height: 100%;
        }
        .product-card:hover {
            box-shadow: 0 4px 8px 0 rgba(0,0,0,.16);
        }
        .card-img-top {
            height: 200px;
            object-fit: contain;
            padding: 1rem;
        }
        .card-body {
            padding: 1rem;
        }
        .card-title {
            font-size: 1rem;
            font-weight: 500;
            color: #212121;
            margin-bottom: 0.5rem;
        }
        .card-text {
            color: #878787;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
        }
        .price {
            font-size: 1.125rem;
            font-weight: 500;
            color: #212121;
        }
        .btn-primary {
            background-color: #ff9f00;
            border-color: #ff9f00;
            color: #fff;
            font-weight: 500;
        }
        .btn-primary:hover {
            background-color: #fb641b;
            border-color: #fb641b;
        }
.product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
}
.card-body {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.product-card:hover {
    transform: scale(1.03);
    box-shadow: 0 6px 12px rgba(0,0,0,0.2);
}
.card-img-top {
    transition: transform 0.3s ease;
}
.card-img-top:hover {
    transform: scale(1.1);
}
.btn-primary {
    background-color: #ff5722;
    border-color: #ff5722;
}
.btn-primary:hover {
    background-color: #e64a19;
}
#heroCarousel img {
    height: 500px; /* Adjust as needed */
    object-fit: cover;
}
   

    </style>

