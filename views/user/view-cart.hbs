

 <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            
        </div>
    </nav>
<section class="container my-5">
  <div class="card shadow-lg p-4">
    <h2 class="mb-4 text-center text-white">Shopping Cart</h2>

    <table class="table table-hover align-middle" id="cart-table">
      <thead class="thead-dark">
        <tr>
          <th scope="col">Item</th>
          <th scope="col">Description</th>
          <th scope="col">Quantity</th>
          <th scope="col">Price</th>
          <th scope="col">Remove</th>
        </tr>
      </thead>
      <tbody>
        {{#if products.length}}
          {{#each products}}
            <tr>
              <td class="text-center">
                <img src="/product-images/{{this.product._id}}.jpg" class="img-thumbnail" style="height:80px; width:80px;">
              </td>
              <td class="text-white">
                <h5>{{this.product.Description}}</h5>
              </td>
           <td>
  <div class="d-flex align-items-center">
    <button class="btn btn-outline-danger btn-sm" 
            onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', -1)">
      <i class="fas fa-minus"></i>
    </button>
    <span id="{{this.product._id}}" class="mx-3 font-weight-bold">{{this.quantity}}</span>
    <button class="btn btn-outline-success btn-sm" 
            onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', 1)">
      <i class="fas fa-plus"></i>
    </button>
  </div>
</td>

              <td class="font-weight-bold text-white">₹{{this.product.Price}}</td>
              <td>
                <button class="btn btn-danger btn-sm" 
                        onclick="Change('{{this._id}}', '{{this.product._id}}', '{{../user}}', -{{this.quantity}})">
                  <i class="fas fa-trash-alt" >  Remove</i>
                </button>
              </td>
            </tr>
          {{/each}}
        {{else}}
          <tr>
            <td colspan="5" class="text-center text-white">
              <h3 class="text-white">Your cart is empty</h3>
              <p class="text-white">It looks like you haven't added any products to your cart yet.</p>
              <a href="/" class="btn btn-primary mt-3 text-white" >Go to Shop</a>
            </td>
          </tr>
        {{/if}}
      </tbody>
    </table>

    <hr>
    {{#if products.length}}
      <div class="d-flex justify-content-between align-items-center mt-4">
        <h3 class="text-white">Total Price: ₹<span id="total">{{total}}</span></h3>
        <a href="/place-order" class="btn btn-success btn-lg">Place Order</a>
      </div>
    {{/if}}
  </div>
</section>

<script>
  function Change(cartid, proid, userid, count) {
    let quantity = parseInt(document.getElementById(proid).innerHTML);
    count = parseInt(count);

    $.ajax({
      url: '/change-product-quantity/',
      data: {
        user: userid,
        cart: cartid,
        product: proid,
        count: count,
        quantity: quantity
      },
      method: 'post',
      success: (response) => {
        if (response.removeproduct) {
          alert("Product removed");
          location.reload(); // Reload to update cart
        } else {
          document.getElementById(proid).innerHTML = quantity + count;
          document.getElementById('total').innerHTML = response.total;
        }
      }
    });
  }
</script>

<style>
  .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5px 10px;
}

.table td {
    vertical-align: middle !important;
}

   /* Ensure table has a dark background */
.table {
   background-color: #72aae6 !important;
    color: white !important;
}

/* Table header should be dark */
.thead-dark th {
 background-color: #72aae6 !important;
    color: white !important;
}

/* Ensure table row text is always white */
.table tbody tr td {
    color: white !important;
}

/* Prevent Bootstrap hover effect */
.table-hover tbody tr:hover {
   background-color: #72aae6 !important;/* Slightly darker but not white */
}

/* Remove Bootstrap default white background */
.table thead, .table tbody, .table tfoot, .table tr, .table td, .table th {
   background-color: #72aae6 !important; !important;
    border-color: rgba(255, 255, 255, 0.1) !important; /* Light border for visibility */
}

/* Prevent buttons from changing colors on hover */
.btn:hover {
    opacity: 0.9;
    background-color: inherit !important;
    color: inherit !important;
}

/* Card background fix */
.card {
   background-color: #72aae6 !important; !important;
}

</style>
