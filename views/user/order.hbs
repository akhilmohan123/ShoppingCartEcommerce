<section>
  <div class="main">
      <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            {{!-- <a class="navbar-brand" href="#">Ecommerce</a> --}}
            {{!-- <form class="d-flex search-bar">
                <input class="form-control me-2" type="search" placeholder="Search for products, brands and more" aria-label="Search">
                <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
            </form> --}}
        </div>
    </nav>
    <div class="container">
    <table class="table" border=1>
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">Address</th>
          <th scope="col">Pincode</th>
          <th scope="col">Payment Method</th>
          <th scope="col">Price</th>
          <th scope="col">Status</th>
          <th scope="col">Product</th>
          <th scope="col">Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each orders}}
        <tr>
          <!-- Order details (rowspan for multi-product orders) -->
          <td rowspan="{{products.length}}">{{Date}}</td>
          <td rowspan="{{products.length}}">{{delivarydetails.address}}</td>
          <td rowspan="{{products.length}}">{{delivarydetails.pincode}}</td>
          <td rowspan="{{products.length}}">{{paymentmethod}}</td>
          <td rowspan="{{products.length}}">₹{{totalprice}}</td>
          <td rowspan="{{products.length}}">{{status}}</td>

          <!-- First product row -->
          <td>{{products.[0].name}}</td>
          <td>
            <a href="/viewproduct/{{products.[0].item}}" class="btn btn-success">View Product</a>
          </td>
        </tr>

        <!-- Additional product rows for the same order -->
        {{#each products}}
          {{#unless @first}}
          <tr>
            <td>{{this.name}}</td>
            <td>
              <a href="/viewproduct/{{this.item}}" class="btn btn-success">View Product</a>
            </td>
          </tr>
          {{/unless}}
        {{/each}}

        {{/each}}
      </tbody>
    </table>
    <hr>
    {{!-- <h3 class="float-right mr-5 mt-4">
      Total Price: ₹{{total}}
    </h3> --}}
        </div>
  </div>
</section>
<style>
.main{
  height: 100%;
  width: 100%;
}
.container{
  height: 70%;
  width: 70%;
  padding-top: 10px;
}

th{

  background-color: rgb(212, 212, 212);

}
 tr:nth-child(even){background-color: #f2f2f2;}
 tr:hover {background-color: #ddd;}
  nav{
          height: 50px;
        }
        .navbar {
            background-color: #1a283e;
            padding: 0.5rem 1rem;
        }
        .navbar-brand {
            color: #fff;
            font-weight: bold;
            font-size: 1.5rem;
        }
        .search-bar {
            width: 100%;
            max-width: 500px;
        }

</style>