<!-- views/user/product-details.hbs or .ejs -->
<section class="container mt-5">
    <div class="card shadow-lg p-4 rounded-lg">
        <h1 class="text-center mb-4 text-primary">Product Details</h1>
        <div class="row align-items-center">
            <!-- Product Image -->
            <div class="col-md-5 text-center">
                <img src="/product-images/{{product._id}}.jpg" alt="{{product.name}}" class="img-fluid rounded shadow">
            </div>
            <!-- Product Info -->
            <div class="col-md-7">
                <h2 class="text-dark font-weight-bold">{{product.Name}}</h2>
                <p class="text-muted">{{product.Description}}</p>
                <p class="text-success font-weight-bold">Price: ₹{{product.Price}}</p>
                <div class="mt-4">
                    <a href="/order" class="btn btn-outline-primary btn-lg">Back to Orders</a>
                    <button class="btn btn-success btn-lg ml-3" onclick="handleclick('{{product._id}}')" >Order Again</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Custom Styles -->
<style>
    .card {
        background: #f8f9fa; /* Light grey background */
        border-radius: 12px;
        border: none;
    }
    .img-fluid {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
    }
    h1, h2 {
        font-family: 'Poppins', sans-serif;
    }
</style>
<script>
function handleclick(id){
         $.ajax({
            url: `/cart/${id}`,
            method: 'GET',  // Capitalize 'POST' (though lowercase 'post' still works) // Ensures proper JSON formatting
            success: function(response) {
               alert("Product added successfully")
            },
            error: function(xhr, status, error) {
                alert("Something went wrong please try again later....")
            }
        });
        }
</script>