<section>
    <nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container-fluid d-flex justify-content-between">
        <a class="navbar-brand" href="#">Ecommerce</a>
        <form class="d-flex search-bar">
            <input class="form-control me-2" type="search" placeholder="Search for products, brands and more">
            <button class="btn btn-outline-light" type="submit"><i class="fas fa-search"></i></button>
        </form>
        <div class="d-flex align-items-center">
            <a href="/cart" class="nav-link text-white position-relative me-3">
                <i class="fas fa-shopping-cart fa-lg"></i>
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="cart-count">0</span>
            </a>
            <a href="/profile" class="nav-link text-white">
                <i class="fas fa-user-circle fa-lg"></i>
            </a>
        </div>
    </div>
</nav>

<section>
    <div class="body" id="product-div">
  <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="/images/discount-shopping-season-with-sale.jpg" class="d-block w-100" alt="Sale Banner">
        </div>
        <div class="carousel-item">
            <img src="/images/front-view-back-school-concept-with-copy-space.jpg" class="d-block w-100" alt="New Arrivals">
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

     <div id="products" class="container mt-4">
    <h3 class="text-center mb-4">Our Featured Products</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
        {{#each data}}
        <div class="col">
            <div class="card product-card" onclick="handleOnclick('{{this._id}}')">
                <img class="card-img-top" src="/product-images/{{this._id}}.jpg" alt="{{this.Name}}">
                <div class="card-body">
                    <h5 class="card-title">{{this.Name}}</h5>
                    <p class="card-text">{{this.Description}}</p>
                    <p class="card-text"><small>{{this.Category}}</small></p>
                    <p class="price">₹{{this.Price}}</p>
                    <button onclick="addtocart('{{this._id}}')" class="btn btn-primary w-100">View Product</button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>
</div>
    <div id="search-content" class="body">
         
        </div>
    </div>
</div>
    </div>
</section>

<script>
    function handleOnclick(id) {
    $.ajax({
        url: `/product-individual/${id}`,
        method: 'GET',
        success: function(response) {
            window.location.href = `/product-individual/${id}`;
        },
        error: function(xhr, status, error) {
            console.error("Error:", error);
        }
    });
}

</script>